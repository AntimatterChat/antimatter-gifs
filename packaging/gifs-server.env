# gifs-server settings, read by gifs-server.service. Restart the service after a change:
#   sudo systemctl restart gifs-server
# Every setting is listed in https://github.com/AntimatterChat/gifs-server#configuration
# (AM_GIFS_* variables). Upgrades keep this file.

# Listen address. Only the Antimatter server needs to reach the service (the GIFs app proxies the
# API and the media), so it listens on this machine only; use :8080 when Antimatter runs elsewhere.
AM_GIFS_LISTEN=127.0.0.1:8080

# API keys, one per line. The package generates a random key in this file at the first install;
# give it to the GIFs app (System Console > Plugins > GIFs > API key).
AM_GIFS_API_KEYS_FILE=/etc/gifs-server/api-keys

# Keys of the clients allowed to upload GIFs and stickers (the GIFs app's "Upload key"); no
# uploads when empty.
#AM_GIFS_UPLOAD_KEYS=

# External URL of the service, used in media URLs; derived from requests when empty.
#AM_GIFS_PUBLIC_URL=https://gifs.example.com

# Behind a reverse proxy only: use its X-Forwarded-* headers.
#AM_GIFS_TRUST_PROXY=true

#AM_GIFS_LOG_LEVEL=info
